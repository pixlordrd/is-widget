    "Done" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bitti"
          }
        }
      }
    },
    "IDIN asks whether to keep going or save the session once it runs longer than this. The alert uses the system notification sound." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bir oturum bu süreyi aştığında IDIN devam etmek mi yoksa kaydetmek mi istediğini sorar. Uyarı, sistem bildirim sesini kullanır."
          }
        }
      }
    },
    "IDIN writes finished tasks to your calendar. Grant access in Settings › Privacy & Security › Calendars." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "IDIN, bitirdiğin işleri takvimine yazar. Erişimi Ayarlar › Gizlilik ve Güvenlik › Takvimler bölümünden ver."
          }
        }
      }
    },
    "Keep Going" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Devam Et"
          }
        }
      }
    },
